# Algod Configuration
ALGOD_URL=http://localhost:4160
ALGOD_TOKEN=your-algod-token-here
# Alternative: Use ALGORAND_DATA to read from algod data directory
# ALGORAND_DATA=/path/to/algod/data

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Security Configuration
ORANGE_API_KEY=your-orange-api-key-here
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000
MAX_REQUEST_SIZE=10485760
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
REQUEST_VALIDATION=true
SANITIZE_INPUT=true

# Caching Configuration
ENABLE_CACHE=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=orange-node:
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_OPTIONAL=false

# Proxy Configuration
PROXY_TIMEOUT=30000
MAX_RETRIES=3
INITIAL_RETRY_DELAY=1000
MAX_RETRY_DELAY=10000
BACKOFF_MULTIPLIER=2.0

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_MONITORING_PERIOD=30000
EXPECTED_RESPONSE_TIME=5000

# Connection Pool Configuration
MAX_CONNECTIONS=100
MIN_CONNECTIONS=5
ACQUIRE_TIMEOUT=5000
IDLE_TIMEOUT=30000
HEALTH_CHECK_INTERVAL=15000
MAX_HEALTH_CHECK_FAILURES=3

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=15000
HEALTH_CHECK_TIMEOUT=5000

# Monitoring Configuration
MONITORING_ENABLED=true
METRICS_ENDPOINT=/metrics
HEALTH_ENDPOINT=/health
COLLECT_METRICS=true
METRICS_INTERVAL=10000
METRICS_RETENTION=86400000

# Alerts Configuration
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_ERROR_RATE=0.05
ALERT_RESPONSE_TIME=10000
ALERT_MEMORY_USAGE=0.8
ALERT_CACHE_HIT_RATE=0.7

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/orange-node.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Audit Configuration
AUDIT_LOGGING=true
AUDIT_LOG_LEVEL=info
LOG_REQUESTS=true
LOG_RESPONSES=true
LOG_ERRORS=true

# CORS Configuration
CORS_ENABLED=true
COMPRESSION_ENABLED=true
HELMET_ENABLED=true