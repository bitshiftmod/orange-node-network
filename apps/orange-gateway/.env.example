# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development
GATEWAY_ID=default-gateway
GATEWAY_NAME=Orange Gateway
GATEWAY_FQDN=localhost
GATEWAY_REGION=us-east

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-characters-long

# Algorand Network Configuration
ALGORAND_NETWORK=testnet
ALGOD_TOKEN=
ALGOD_SERVER=http://localhost
ALGOD_PORT=4001
INDEXER_TOKEN=
INDEXER_SERVER=http://localhost
INDEXER_PORT=8980

# Smart Contract Bridge Configuration
SMART_CONTRACT_BRIDGE_ENABLED=true
NODE_REGISTRY_APP_ID=12345
ORANGE_SUBSCRIPTIONS_APP_ID=67890

# Smart Contract Bridge Cache Configuration
BRIDGE_CACHE_TTL=300
BRIDGE_CACHE_MAX_SIZE=100

# Load Balancer Configuration
LOAD_BALANCER_STRATEGY=balanced
LOAD_BALANCER_MAX_NODES=50
LOAD_BALANCER_HEALTH_CHECK_INTERVAL=30000
LOAD_BALANCER_FAILURE_THRESHOLD=3
LOAD_BALANCER_RECOVERY_THRESHOLD=2
LOAD_BALANCER_ENABLE_FAILOVER=true
LOAD_BALANCER_CACHE_RESULTS=true
LOAD_BALANCER_SUBSCRIPTION_AWARE=true

# Load Balancing Weights (must sum to 1.0)
LOAD_BALANCER_REPUTATION_WEIGHT=0.4
LOAD_BALANCER_HEALTH_WEIGHT=0.3
LOAD_BALANCER_STAKE_WEIGHT=0.3

# P2P Configuration
P2P_ENABLED=true
P2P_PORT=4002
P2P_BOOTSTRAP_NODES=
P2P_MAX_PEERS=50
P2P_DISCOVERY_INTERVAL=30000

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3001
WEBSOCKET_HOST=localhost
WEBSOCKET_PATH=/ws
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_HEARTBEAT_INTERVAL=30000
WEBSOCKET_CONNECTION_TIMEOUT=120000
WEBSOCKET_ENABLE_COMPRESSION=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# GraphQL Configuration
GRAPHQL_ENABLED=true
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_RATE_LIMITING=true
GRAPHQL_VALIDATION=true
GRAPHQL_MAX_COMPLEXITY=1000
ENABLE_FEDERATION=false

# Federation Configuration (if enabled)
FEDERATION_MODE=gateway
FEDERATION_SUBGRAPH_NAME=orange-network
FEDERATION_SUBGRAPH_URL=http://localhost:3000/graphql
FEDERATION_SERVICES=[]

# Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_LOG_LEVEL=info
METRICS_ENDPOINT=/metrics
ENABLE_PROMETHEUS=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/gateway.log

# Authentication Configuration
AUTH_ENABLED=true
AUTH_API_KEY_HEADER=X-API-Key
AUTH_JWT_HEADER=Authorization
AUTH_SESSION_SECRET=your-session-secret-key