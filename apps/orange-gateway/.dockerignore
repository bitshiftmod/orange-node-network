# Security-focused .dockerignore
# Exclude sensitive and unnecessary files from Docker builds

# Dependencies that will be installed in container
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Security sensitive files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.p12
*.crt
*.pfx

# Test and coverage files (exclude from production image)
coverage
.nyc_output
test-results
.jest
**/*.test.ts
**/*.spec.ts

# Development and build tools
.eslintrc*
.prettierrc*
jest.config.js
jest.config.json
tsconfig.test.json

# Documentation
README.md
CHANGELOG.md
*.md
docs/

# Git
.git
.gitignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
circle.yml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Temporary files
tmp
temp/
.tmp/

# Security scanning files
.snyk
.npm-audit-report.json

# Development tools
.nyc_output
coverage/
node_modules/.cache/

# Build artifacts that will be recreated
dist/
build/
out/

# Package manager files
package-lock.json
yarn.lock