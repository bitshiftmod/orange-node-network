{
  "name": "@orange-node-network/orange-gateway",
  "version": "1.0.0",
  "description": "Orange Node Network Gateway with comprehensive security testing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:test": "tsc --project tsconfig.test.json",
    "start": "node dist/index.js",
    "start:test": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:security": "eslint src --ext .ts --config .eslintrc-security.js",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level moderate",
    "security:scan": "npx snyk test --severity=high",
    "test:security": "node src/tests/security/SecurityTestRunner.js",
    "test:security:unit": "jest src/tests/security/unit --coverage --coverageReporters=json --coverageReporters=text",
    "test:security:integration": "jest src/tests/security/integration --coverage --coverageReporters=json --coverageReporters=text",
    "test:security:e2e": "jest src/tests/security/e2e --coverage --coverageReporters=json --coverageReporters=text",
    "test:security:comprehensive": "npm run test:security:unit && npm run test:security:integration && npm run test:security:e2e",
    "posttest": "npm run test:coverage"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.1.2",
    "algosdk": "^3.5.2",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "rate-limiter-flexible": "^3.0.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "artillery": "^2.0.3",
    "autocannon": "^7.14.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^1.7.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "security",
    "authentication",
    "authorization",
    "penetration-testing",
    "vulnerability",
    "algorand",
    "blockchain",
    "api",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bitshiftmod/orange-node-network.git"
  },
  "bugs": {
    "url": "https://github.com/bitshiftmod/orange-node-network/issues"
  },
  "homepage": "https://github.com/bitshiftmod/orange-node-network#readme",
  "author": "Orange Node Network Team",
  "license": "MIT",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && npm run typecheck",
      "pre-push": "npm run test:security:unit"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "./src/tests/security/": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
