# Network Configuration
# Copy this file to .env and update with your actual values

# Algorand Network Configuration
ALGOD_HOST=localhost
ALGOD_PORT=4001
ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Indexer Configuration
INDEXER_HOST=localhost
INDEXER_PORT=8980
INDEXER_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# KMD Configuration (for localnet)
KMD_HOST=localhost
KMD_PORT=4002
KMD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Account Mnemonics (DO NOT COMMIT REAL VALUES TO REPOSITORY)
DEPLOYER_MNEMONIC=your deployer mnemonic here
ADMIN_MNEMONIC=your admin mnemonic here
TEST_ACCOUNT1_MNEMONIC=your test account mnemonic here
TEST_ACCOUNT2_MNEMONIC=your test account mnemonic here
TEST_ACCOUNT3_MNEMONIC=your test account mnemonic here

# Network Settings
NETWORK=localnet
MIN_BALANCE=1000000
ENABLE_LOGGING=true
DEBUG_MODE=true

# Contract Settings
ENABLE_CIRCUIT_BREAKER=true
ENABLE_PAUSE=true
DEFAULT_SLASHING_PERCENTAGE=5000
DEFAULT_REPUTATION_THRESHOLD=300

# Gas and Fee Settings
FLAT_FEE=1000
MIN_FEE=1000
MAX_FEE=10000000
APPROVAL_PROGRAM_GAS=7000
CLEAR_PROGRAM_GAS=2500
METHOD_CALL_GAS=1000

# Testing Settings
ENABLE_DEBUG=true
ENABLE_LOGS=true
TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Monitoring Settings
ENABLE_METRICS=true
ENABLE_ALERTS=true
ALERT_THRESHOLD_GAS_USAGE=0.8
ALERT_THRESHOLD_ERRORS=0.1
ALERT_THRESHOLD_RESPONSE_TIME=5000

# Security Settings
REQUIRE_MULTISIG=false
MIN_SIGNATURES=1
TIMELOCK=3600
ENABLE_PAUSE=true
ENABLE_CIRCUIT_BREAKER=true

# File Paths
ARTIFACTS_DIR=./artifacts
BUILD_DIR=./build
CONTRACTS_DIR=./contracts
TESTS_DIR=./tests
DEPLOYMENT_DIR=./deployment

# Node.js Settings
NODE_ENV=development
PORT=3000
HOST=localhost