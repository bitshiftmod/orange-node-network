{
  "name": "orange-smart-contracts",
  "version": "1.0.0",
  "description": "Orange Node Network Smart Contracts - AlgoKit TypeScript Implementation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:contracts && npm run generate:clients && npm run build:deploy",
    "build:contracts": "algokit compile typescript src --out-dir artifacts",
    "generate:clients": "npm run generate:client:node && npm run generate:client:gateway && npm run generate:client:subscriptions",
    "generate:client:node": "algokit generate client src/artifacts/OrangeNodeRegistry.arc32.json --output src/clients/OrangeNodeRegistryClient.ts",
    "generate:client:gateway": "algokit generate client src/artifacts/OrangeGatewayRegistry.arc32.json --output src/clients/OrangeGatewayRegistryClient.ts",
    "generate:client:subscriptions": "algokit generate client src/artifacts/OrangeSubscriptionsContract.arc32.json --output src/clients/OrangeSubscriptionsClient.ts",
    "build:deploy": "tsc",
    "build:all": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "algokit": "algokit",
    "deploy:local": "node dist/deploy/localnet.js",
    "deploy:test": "node dist/deploy/testnet.js",
    "deploy:mainnet": "node dist/deploy/mainnet.js",
    "clean": "rm -rf dist artifacts .algokit src/clients",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.1.2",
    "@algorandfoundation/algorand-typescript": "^1.0.1",
    "algosdk": "^3.5.2"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "latest",
    "@algorandfoundation/algorand-typescript-testing": "^1.0.1",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.20",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.25.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=8.0.0"
  },
  "algokit": {
    "type": "client-generator",
    "language": "typescript"
  }
}
